# Store the bridge settings and render the container environment file.

import json
import os
import sys

import agent

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "pypkg"))
import bridge_setup

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)

with bridge_setup.settings_lock():
    try:
        settings = bridge_setup.apply_request(data)
    except bridge_setup.SettingsError as error:
        agent.set_status("validation-failed")
        json.dump([{
            "field": error.field,
            "parameter": error.field,
            "value": error.value,
            "error": error.error,
        }], fp=sys.stdout)
        sys.exit(2)
    bridge_setup.write_env(settings)
